# ============================================================================
# v7 前端机配置样例：cp .env.example .env 后按机器实际情况填写
# ⚠️ 改完 .env 必须 `docker compose up -d` 重建容器——`restart` 不会重读 .env
# ============================================================================

# ── 必填 ────────────────────────────────────────────────────────────────────

# 本机唯一标识：仅用于回报归属（?agent=），各公司后台据此区分每台前端机
FRONT_SERVER_NAME=prod-front-01

# 公司清单（JSON 数组，注意整体用单引号包住）：
#   name    公司标识（目录名/upstream 前缀，小写字母数字下划线连字符）
#   baseUrl 公司 Java 管理后台地址（Host 决定租户隔离，必须是该公司的管理域名）
#   token   该公司的接入 token（运维 `openssl rand -hex 32` 生成，存密码库）
#   可选: "caFile":"/path/ca.pem" 自定义 CA；"insecureSkipVerify":true 跳过校验（仅调试）
COMPANIES='[
  {"name":"xyz","baseUrl":"https://admin.xyz-example.com","token":"换成真实token"},
  {"name":"ht","baseUrl":"https://admin.ht-example.com","token":"换成真实token"}
]'

# ── 常用可选 ────────────────────────────────────────────────────────────────

# 持久卷在宿主机上的路径（配置/证书/状态/日志的「现场」）
HOST_DATA_DIR=/data/v7-front

# nginx 与 agent 的统一基础镜像（锁定版本，杜绝 nginx -t 版本错位；需 ≥1.27.4）
NGINX_IMAGE=nginx:1.29-alpine

# 轮询周期 / reload 防抖最小间隔
POLL_INTERVAL=15s
RELOAD_MIN_INTERVAL=30s

# access 日志开关：默认关（error 日志永远保留）；排障时改 on 后 up -d
NGINX_ACCESS_LOG=off
# agent 日志级别：info=仅状态变化输出一行；排障用 debug
AGENT_LOG_LEVEL=info
# nginx 日志轮转：单文件上限 / gzip 保留份数（硬上限 ≈ 上限×(份数+1)×日志路数）
NGINX_LOG_MAX_FILE=256m
NGINX_LOG_KEEP=4

# nginx 容器文件句柄上限（soft=hard）。空=默认 1048576，已高于自动调优的
# worker_rlimit_nofile（公式上限 131072）；仅当你手动调高 TUNE_WORKER_RLIMIT_NOFILE 超过它时才需设
FRONT_NOFILE_LIMIT=

# ── 资源配额（空 = 不限/用宿主机规格；自动调优按同样的值计算 nginx 参数）────
FRONT_CPU_LIMIT=
FRONT_MEM_LIMIT=
# 磁盘为「计算配额」（bind mount 无法容器级强制，由磁盘水位保护兜底）
FRONT_DISK_LIMIT=

# ── 批量删除护栏 ────────────────────────────────────────────────────────────
# 某公司单轮删除域名数 > max(MIN, 现有总数×RATIO) 时冻结该公司并回报 error；
# 运维确认后在前端机执行 `touch <HOST_DATA_DIR>/ack-<公司名>` 放行一次
DELETE_GUARD_MIN=100
DELETE_GUARD_RATIO=0.30

# ── 调优覆盖（TUNE_ 前缀，空 = 用自动公式）──────────────────────────────────
TUNE_WORKER_PROCESSES=
TUNE_WORKER_CONNECTIONS=
TUNE_WORKER_RLIMIT_NOFILE=
TUNE_SSL_CERT_CACHE_MAX=
TUNE_SSL_SESSION_CACHE=
TUNE_IMAGE_CACHE_MAX_SIZE=
TUNE_NUXT_CACHE_MAX_SIZE=
