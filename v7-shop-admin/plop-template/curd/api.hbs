import request from '/@/utils/request'

export function page(data: any) {
  return request({
    url: '/{{toLowerCase name}}/page',
    method: 'post',
    data,
  })
}

export function doEdit(data: any) {
  return request({
    url: '/{{toLowerCase name}}/doEdit',
    method: 'post',
    data,
  })
}

export function doDelete(data: any) {
  return request({
    url: '/{{toLowerCase name}}/doDelete',
    method: 'post',
    data,
  })
}
export function switchValidity(data: any) {
