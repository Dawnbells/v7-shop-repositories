# Nuxt 主题编辑器环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# iframe postMessage 允许的 origin 白名单
# 多个 origin 用逗号分隔，如 "https://admin.example.com,https://dev.example.com"
# 设置为 "*" 允许所有来源（仅用于开发环境）
NUXT_PUBLIC_ALLOWED_ORIGINS=*

# 图片基础链接（相对路径会拼接此前缀）
# NUXT_PUBLIC_IMAGE_BASE_URL=https://cdn1.example.com

# 图片降级链接（主链接失败时换此前缀重试）
# NUXT_PUBLIC_IMAGE_FALLBACK_URL=https://cdn2.example.com

# 开发环境域名（可选）
# NUXT_DEV_DOMAIN=

# HTTP 代理（可选，用于开发环境或需要代理的场景）
# NUXT_HTTP_PROXY=
