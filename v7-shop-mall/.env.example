# 数据库配置
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_USER=root
NUXT_DB_PASSWORD=
NUXT_DB_DATABASE=shop

# Redis配置
NUXT_REDIS_HOST=127.0.0.1
NUXT_REDIS_PORT=6379
NUXT_REDIS_PASSWORD=
NUXT_REDIS_DB=0

# 风控服务地址
NUXT_RISK_SERVICE_URL=

# 开发环境模拟域名（本地开发时使用此域名查询商城信息）
NUXT_DEV_DOMAIN=

# HTTP 代理（用于开发环境或需要代理的场景）
NUXT_HTTP_PROXY=

# 允许的跨域来源
NUXT_PUBLIC_ALLOWED_ORIGINS=*

# 图片基础链接（相对路径会拼接此前缀）
NUXT_PUBLIC_IMAGE_BASE_URL=

# 图片降级链接（主链接失败时换此前缀重试）
NUXT_PUBLIC_IMAGE_FALLBACK_URL=
