{
  "manifest_version": 3,
  "name": "TurboFlow Bridge",
  "version": "1.5.0",
  "description": "Image translation through Google Flow page automation using Nano Banana models",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*",
        "https://flow.google.com/*"
      ],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/fx/*",
        "https://flow.google.com/*"
      ],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TurboFlow Bridge"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
