{
  "manifest_version": 3,
  "name": "TurboFlow Bridge",
  "version": "1.1.0",
  "description": "Image translation via Google Flow - upload an image, auto-translate overlay text using Nano Banana 2",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*/tools/flow/*",
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://labs.google/fx/*/tools/flow/*",
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
