# ==================== 环境变量配置 ====================
# 复制此文件为 application.yml 并填写实际配置

REDIS_HOST: 127.0.0.1
REDIS_PORT: 6379
SA_REDIS_DATABASE: 0
REDIS_DATABASE: 1
REDIS_PASSWORD: your_redis_password

# 数据库
MYSQL_DB_NAME: db-v7-shop
MYSQL_URL: 127.0.0.1
MYSQL_PASSWORD: your_mysql_password
MYSQL_PORT: 3306

MYSQL_ADDRESS_DB_NAME: db-v7-shop-addresses
MYSQL_ADDRESS_URL: 127.0.0.1
MYSQL_ADDRESS_PORT: 3306
MYSQL_ADDRESS_PASSWORD: your_mysql_password

# S3 存储配置
S3_ACCESS_KEY_ID: your_s3_access_key_id
S3_ACCESS_KEY_SECRET: your_s3_access_key_secret
S3_ENDPOINT: https://your-s3-endpoint.com
S3_REGION: auto
S3_BUCKET_NAME: your-bucket-name

# 阿里云 OSS 配置
ALIYUN_OSS_REGION: oss-eu-central-1
ALIYUN_OSS_ACCESS_KEY_ID: your_aliyun_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET: your_aliyun_access_key_secret
ALIYUN_OSS_ENDPOINT: https://oss-eu-central-1.aliyuncs.com
ALIYUN_OSS_BUCKET_NAME: your-bucket-name

# 媒体配置
AUDIO_SUFFIXES: mp3,wav
VIDEO_SUFFIXES: mp4
IMAGE_SUFFIXES: jpeg,jpg,png,webp,gif
MAX_IMAGE_SIZE: 20
MAX_VIDEO_SIZE: 30
MAX_AUDIO_SIZE: 20
SUPPORT_WIDTHS: 160,320,480,640,960,1280,1600,1920

# 外部服务
CONFIG_CENTER_BASE_URL: https://your-config-center.com
CLOAK_BASE_URL: https://your-cloak-service.com

PORT: 32006
server:
  port: ${PORT:32006}
  max-http-request-header-size: 102400

############## Sa-Token 配置 (文档: https://sa-token.cc) ##############
sa-token:
  # jwt秘钥
  jwt-secret-key: your_jwt_secret_key
  # token前缀
  token-prefix: Bearer
  # token 名称（同时也是 cookie 名称）
  token-name: Authorization
  # ------- SSO-模式二相关配置
  is-read-cookie: false
  # token 最低活跃频率（单位：秒），如果 token 超过此时间没有访问系统就会被冻结，默认-1 代表不限制，永不冻结
  active-timeout: -1
  # 是否允许同一账号多地同时登录 （为 true 时允许一起登录, 为 false 时新登录挤掉旧登录）
  is-concurrent: false
  # 在多人登录同一账号时，是否共用一个 token （为 true 时所有登录共用一个 token, 为 false 时每次登录新建一个 token）
  is-share: false
  # 配置 Sa-Token 单独使用的 Redis 连接
  alone-redis:
    # Redis数据库索引（默认为0）
    database: ${SA_REDIS_DATABASE:0}
    # Redis服务器地址
    host: ${REDIS_HOST:127.0.0.1}
    # Redis服务器连接端口
    port: ${REDIS_PORT:6379}
    # Redis服务器连接密码（默认为空）
    password: ${REDIS_PASSWORD}
    # 连接超时时间
    timeout: 10s

spring:
  profiles:
    active: dev
  application:
    name: ${APP_NAME:v7-shop}
  main:
    allow-bean-definition-overriding: true
  datasource:
    primary:
      password: ${MYSQL_PASSWORD}
      driver-class-name: com.mysql.cj.jdbc.Driver
      jdbcUrl: jdbc:mysql://${MYSQL_URL}:${MYSQL_PORT}/${MYSQL_DB_NAME}?allowMultiQueries=true&jdbcCompliantTruncation=false&useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&useAffectedRows=true&allowPublicKeyRetrieval=true
      username: ${MYSQL_USER:root}
      connection-test-query: SELECT 1
      connection-timeout: ${EQUITY_DB_CONNECTION_TIMEOUT:30000}
      idle-timeout: ${EQUITY_DB_IDLE_TIMEOUT:180000}
      max-lifetime: ${EQUITY_DB_MAX_LIFETIME:1800000}
      maximum-pool-size: ${EQUITY_DB_MAX_POOL_SIZE:50}
      minimum-idle: ${EQUITY_DB_IDLE_POOL_SIZE:5}
      pool-name: EquityHikariCP
    address:
      password: ${MYSQL_ADDRESS_PASSWORD}
      driver-class-name: com.mysql.cj.jdbc.Driver
      jdbcUrl: jdbc:mysql://${MYSQL_ADDRESS_URL}:${MYSQL_ADDRESS_PORT}/${MYSQL_ADDRESS_DB_NAME}?allowMultiQueries=true&jdbcCompliantTruncation=false&useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&useAffectedRows=true&allowPublicKeyRetrieval=true
      username: ${MYSQL_ADDRESS_USER:root}
      connection-test-query: SELECT 1
      connection-timeout: ${EQUITY_DB_CONNECTION_TIMEOUT:30000}
      idle-timeout: ${EQUITY_DB_IDLE_TIMEOUT:180000}
      max-lifetime: ${EQUITY_DB_MAX_LIFETIME:1800000}
      maximum-pool-size: ${EQUITY_DB_MAX_POOL_SIZE:50}
      minimum-idle: ${EQUITY_DB_IDLE_POOL_SIZE:5}
      pool-name: EquityHikariCP
  jpa:
    show-sql: true
    properties:
      hibernate:
        session_factory:
          statement_inspector: cn.v7soft.dao.resolver.GlobalDataRangeFilterInterceptor
        format_sql: true
        hbm2ddl:
          auto: update
        show_sql: false
    database-platform: cn.v7soft.core.configurer.MySQLDialectConfig
    open-in-view: true

  servlet:
    multipart:
      enabled: true
      max-file-size: -1
      max-request-size: -1
  data:
    # redis配置
    redis:
      # Redis数据库索引（默认为0）
      database: ${REDIS_DATABASE:1}
      # Redis服务器地址
      host: ${REDIS_HOST}
      # Redis服务器连接端口
      port: ${REDIS_PORT}
      # Redis服务器连接密码（默认为空）
      password: ${REDIS_PASSWORD}
      # 连接超时时间
      timeout: 10s
      lettuce:
        pool:
          # 连接池最大连接数
          max-active: 200
          # 连接池最大阻塞等待时间（使用负值表示没有限制）
          max-wait: -1ms
          # 连接池中的最大空闲连接
          max-idle: 10
          # 连接池中的最小空闲连接
          min-idle: 0
  thymeleaf:
    prefix: classpath:/templates/
    suffix: html
    mode: HTML
    encoding: UTF-8
    cache: false
  jackson:
    default-property-inclusion: non_null
    time-zone: "Asia/Shanghai"
    date-format: yyyy-MM-dd HH:mm:ss

# 前端服务器三级健康检查（主IP > 备用IP > 兜底IP）
# 探测目标为 http://<IP>/health，需前端机 nginx 在 80 端口提供该端点并返回 {"status":"ok"}
front-server:
  health-check:
    # 轮次间隔；连续 3 次同结果才确认健康/故障，即最快 3 个间隔完成判定
    interval-ms: ${FRONT_SERVER_HEALTH_CHECK_INTERVAL_MS:5000}
    # 单次探测的连接与读取超时，两者相加是最坏耗时（默认合计 6 秒，已超过轮次间隔）
    connect-timeout-ms: ${FRONT_SERVER_HEALTH_CHECK_CONNECT_TIMEOUT_MS:3000}
    read-timeout-ms: ${FRONT_SERVER_HEALTH_CHECK_READ_TIMEOUT_MS:3000}
    # 心跳摘要周期（轮）：每隔这么多轮打一条各节点状态与 DNS 指向；同时作为失败日志的去重周期。
    # 0 = 关闭心跳摘要（不推荐，稳态下将没有任何日志可确认任务在运行）
    heartbeat-rounds: ${FRONT_SERVER_HEALTH_CHECK_HEARTBEAT_ROUNDS:60}

# 日志配置
logging:
  level:
    root: info
    cn.v7soft: debug
    # 健康检查排障：临时加一行 cn.v7soft.admin.task: trace，
    # 可看到每轮摘要、每次探测耗时与 DNS 回查流水（稳态下量大，勿常开）
    org.hibernate: info
    org.hibernate.SQL: info
    org.hibernate.type.descriptor.sql.BasicBinder: info
  file:
    path: ./logging/
  logback:
    rollingpolicy:
      file-name-pattern: ./logging/logging-%d{yyyy-MM-dd}.%i.log
      max-file-size: 1MB
      max-history: 150
      total-size-cap: 200MB

forest:
  log-enabled: true
  max-connections: 1000
  connect-timeout: 2000
  read-timeout: 2000
  converters:
    json:
      type: cn.v7soft.common.forest.config.CustomForestJacksonConverter

application:
  theme-editor:
    dev-url: ${THEME_EDITOR_DEV_URL:http://localhost:3000/builder}
  config-center:
    base-url: ${CONFIG_CENTER_BASE_URL}
  cloak:
    base-url: ${CLOAK_BASE_URL}
  # 前端机 agent 接口（/front-agent/**）配置，详见 docs/superpowers/specs/2026-06-12-nginx-config-refactor-design.md
  front-agent:
    # 静态 Bearer token，逗号分隔支持多值并存（双 token 轮换窗口）；为空 = 接口禁用（一律 401）
    tokens: ${FRONT_AGENT_TOKENS:}
    # 证书根目录，布局：{certs-dir}/{companyId}/{domain}/fullchain.pem|privkey.pem
    certs-dir: /www/certs/
    # manifest 内存快照有效期（毫秒），吸收多台前端机轮询
    manifest-cache-millis: 3000
    # 各服务类型的 upstream 地址（host:port，逗号分隔可多个），供前端 nginx 渲染 upstream 块
    services:
      NUXT_MALL: ${FRONT_AGENT_SERVICE_NUXT_MALL:}
      VIKE: ${FRONT_AGENT_SERVICE_VIKE:}
      THYMELEAF: ${FRONT_AGENT_SERVICE_THYMELEAF:}
  s3:
    access-key-id: ${S3_ACCESS_KEY_ID}
    endpoint: ${S3_ENDPOINT}
    region: ${S3_REGION}
    bucket-name: ${S3_BUCKET_NAME}
    access-key-secret: ${S3_ACCESS_KEY_SECRET}
  multimedia:
    audio-suffixes: ${AUDIO_SUFFIXES:mp3,wav}
    video-suffixes: ${VIDEO_SUFFIXES:mp4}
    images-suffixes: ${IMAGE_SUFFIXES:jpeg,jpg,png,webp,gif}
    max-image-size: ${MAX_IMAGE_SIZE:20}
    max-video-size: ${MAX_VIDEO_SIZE:20}
    max-audio-size: ${MAX_AUDIO_SIZE:20}
    support-widths: ${SUPPORT_WIDTHS:160,320,480,640,960,1280,1600,1920}
    oss:
      endpoint: ${ALIYUN_OSS_ENDPOINT}
      region: ${ALIYUN_OSS_REGION}
      access-key-id: ${ALIYUN_OSS_ACCESS_KEY_ID}
      access-key-secret: ${ALIYUN_OSS_ACCESS_KEY_SECRET}
      bucket-name: ${ALIYUN_OSS_BUCKET_NAME}
